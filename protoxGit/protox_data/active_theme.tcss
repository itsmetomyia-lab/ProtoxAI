
/* ================================================================
   PROTOX AI v3.1 — ULTRA PREMIUM THEME
   Auto-generated — do not edit manually
   ================================================================ */

/* ── SCREEN ──────────────────────────────────────────────────────── */
Screen {
    background: #0e0c0a;
    color:      #e8e3dd;
    overflow:   hidden;
}

/* ── HEADER ──────────────────────────────────────────────────────── */
Header {
    dock:         top;
    height:       1;
    background:   #0e0c0a;
    color:        #ef7c53;
    text-style:   bold;
    border-bottom: hkey #2a2520;
}
Header .header--icon { display: none; }

/* ── FOOTER ──────────────────────────────────────────────────────── */
#custom-footer {
    dock:       bottom;
    height:     3;
    background: #252017;
    color:      #7a7268;
    layout:     vertical;
    padding:    0;
    border-top: hkey #ef7c53 50%;
}
#footer-accent-line {
    height:     1;
    background: #ef7c53;
    color:      #0e0c0a;
    text-style: bold;
    text-align: center;
    padding:    0 2;
}
#footer-line-top {
    height:     1;
    layout:     horizontal;
    padding:    0 1;
    background: #252017;
}
#footer-line-bot {
    height:     1;
    layout:     horizontal;
    padding:    0 1;
    background: #181512;
    border-top: solid #2a2520;
}
.fkey {
    color:      #0e0c0a;
    background: #ef7c53;
    text-style: bold;
    padding:    0 1;
}
.fkey-dim {
    color:      #c8c0b8;
    background: #1e1a14;
    text-style: bold;
    padding:    0 1;
}
.flabel {
    color:        #a8a098;
    padding:      0 1;
    margin-right: 1;
}
.fright {
    dock:       right;
    color:      #ef7c53;
    text-style: bold;
    padding:    0 1;
}
.fright-dim {
    dock:       right;
    color:      #7a7268;
    padding:    0 1;
    text-style: italic;
}

/* ── MAIN LAYOUT ─────────────────────────────────────────────────── */
#main-layout {
    layout: horizontal;
    height: 1fr;
}

/* ── SIDEBAR ─────────────────────────────────────────────────────── */
#sidebar {
    width:        34;
    height:       100%;
    border-right: tall #2a2520;
    background:   #181512;
    layout:       vertical;
}
#sidebar.hidden { display: none; }
#sidebar-header {
    height:        5;
    background:    #0e0c0a;
    border-bottom: hkey #ef7c53 50%;
    layout:        vertical;
    content-align: center middle;
    padding:       0 1;
}
#sidebar-brand-line {
    height:     1;
    background: #ef7c53;
    color:      #0e0c0a;
    text-style: bold;
    text-align: center;
    width:      100%;
}
#sidebar-brand {
    color:      #ef7c53;
    text-style: bold;
    text-align: center;
    width:      100%;
    margin-top: 1;
}
#sidebar-version {
    color:      #5a524a;
    text-align: center;
    width:      100%;
    text-style: italic;
}
#sidebar-engine {
    color:      #00e5b8;
    text-align: center;
    width:      100%;
    text-style: bold;
}
#session-body {
    height:     1fr;
    padding:    0;
    layout:     vertical;
    overflow-y: auto;
}
.sb-section {
    height: auto;
    layout: vertical;
}
.sb-section-head {
    color:        #ef7c53;
    background:   #0e0c0a;
    text-style:   bold;
    padding:      0 2;
    height:       1;
    border-bottom: solid #2a2520;
    border-top:   solid #2a2520;
}
.sb-row {
    layout:     horizontal;
    height:     1;
    padding:    0 2;
    background: #181512;
}
.sb-row:hover { background: #252017; }
.sb-key     { color: #7a7268;  width: 12; text-style: italic; }
.sb-val     { color: #c8c0b8; width: 1fr; }
.sb-val-bright { color: #ef7c53; text-style: bold; width: 1fr; }
.sb-val-ok  { color: #4ecb71;   text-style: bold; width: 1fr; }
.sb-val-warn { color: #e8c41a; text-style: bold; width: 1fr; }
.sb-val-ai  { color: #00e5b8;   text-style: bold; width: 1fr; }
.sb-spacer  { height: 1; background: #181512; }
#sidebar-footer {
    height:        1;
    background:    #0e0c0a;
    color:         #5a524a;
    text-align:    center;
    content-align: center middle;
    border-top:    hkey #ef7c53 50%;
    padding:       0 1;
    text-style:    italic;
}

/* ── CONTENT AREA ────────────────────────────────────────────────── */
#content-area {
    width:  1fr;
    height: 100%;
    layout: vertical;
}

/* ── DASHBOARD ───────────────────────────────────────────────────── */
#dashboard {
    width:      100%;
    height:     auto;
    layout:     vertical;
    background: #0e0c0a;
}
#dash-hero {
    height:        auto;
    background:    #0e0c0a;
    layout:        vertical;
    padding:       1 4;
    border-bottom: hkey #ef7c53 50%;
}
#dash-logo {
    color:      #ef7c53;
    text-style: bold;
    text-align: center;
    width:      100%;
}
#dash-tagline {
    color:      #00e5b8;
    text-align: center;
    width:      100%;
    text-style: bold;
    margin-top: 1;
}
#dash-subtitle {
    color:      #7a7268;
    text-align: center;
    width:      100%;
    text-style: italic;
}
#dash-accent-bar {
    height:     1;
    background: #ef7c53;
    color:      #0e0c0a;
    text-style: bold;
    text-align: center;
}
#dash-cards {
    layout:     horizontal;
    height:     auto;
    padding:    1 2;
    background: #0e0c0a;
}
.dash-card {
    width:      1fr;
    height:     auto;
    background: #181512;
    border:     tall #2a2520;
    padding:    1 2;
    margin:     0 1;
    layout:     vertical;
}
.dash-card:hover { border: tall #ef7c53 50%; }
.dash-card-title {
    color:      #ef7c53;
    text-style: bold;
    height:     1;
    border-bottom: solid #2a2520;
}
.dash-card-sep       { color: #2a2520; height: 1; }
.dash-card-item      { color: #a8a098; height: 1; padding: 0 0 0 1; }
.dash-card-item:hover { color: #e8e3dd; background: #252017; }
.dash-card-item-bright { color: #ef7c53; height: 1; text-style: bold; padding: 0 0 0 1; }
.dash-card-item-ai   { color: #00e5b8;   height: 1; text-style: italic; padding: 0 0 0 1; }
#dash-status-bar {
    height:        1;
    background:    #181512;
    layout:        horizontal;
    padding:       0 3;
    border-top:    solid #2a2520;
    border-bottom: solid #2a2520;
}
.dash-status-dot  { color: #4ecb71;   text-style: bold; width: 3; }
.dash-status-item { color: #5a524a; margin-right: 1; text-style: italic; }
.dash-status-val  { color: #ef7c53;  text-style: bold; margin-right: 3; }
#dash-quote {
    height:     2;
    color:      #00e5b8;
    text-style: italic;
    text-align: center;
    padding:    1 4;
    background: #0e0c0a;
}

/* ── CHAT ────────────────────────────────────────────────────────── */
#chat-scroll {
    height:     1fr;
    width:      100%;
    overflow-y: auto;
    background: #0e0c0a;
    layout:     vertical;
    padding:    1 3;
}
.chat-message {
    width:  100%;
    height: auto;
    layout: vertical;
    margin: 0 0 1 0;
}
/* user */
.msg-user-header { layout: horizontal; height: 1; margin-bottom: 0; }
.msg-user-icon   { color: #ef7c53; text-style: bold; width: 4; }
.msg-user-name   { color: #ef7c53; text-style: bold; width: auto; }
.msg-user-time   { color: #5a524a; margin-left: 2; width: auto; text-style: italic; }
.chat-bubble-user {
    background:  #252017;
    border-left: tall #ef7c53;
    padding:     1 2;
    color:       #e8e3dd;
    margin:      0 2 0 4;
}
/* ai */
.msg-ai-header  { layout: horizontal; height: 1; margin-bottom: 0; }
.msg-ai-icon    { color: #00e5b8; text-style: bold; width: 4; }
.msg-ai-name    { color: #00e5b8; text-style: bold; width: auto; }
.msg-ai-time    { color: #5a524a; margin-left: 2; width: auto; text-style: italic; }
.msg-ai-engine  { color: #5a524a; margin-left: 1; text-style: italic; width: auto; }
.chat-bubble-ai {
    background:  #181512;
    border-left: tall #00e5b8;
    padding:     1 2;
    color:       #e8e3dd;
    margin:      0 0 0 4;
}
/* system */
.msg-sys-header { layout: horizontal; height: 1; margin-bottom: 0; }
.msg-sys-icon   { color: #e8c41a; text-style: bold; width: 4; }
.msg-sys-tag    { color: #7a7268;  text-style: italic; }
.chat-bubble-sys {
    background:  #181512;
    border-left: tall #e8c41a;
    padding:     0 2;
    color:       #7a7268;
    margin:      0 0 0 4;
    text-style:  italic;
}
/* error */
.msg-err-header { layout: horizontal; height: 1; margin-bottom: 0; }
.msg-err-icon   { color: #ff4444; text-style: bold; width: 4; }
.msg-err-tag    { color: #ff4444; text-style: bold; }
.chat-bubble-err {
    background:  #0e0c0a;
    border-left: tall #ff4444;
    padding:     1 2;
    color:       #ff4444;
    margin:      0 0 0 4;
}

/* ── INPUT AREA ──────────────────────────────────────────────────── */
#input-wrapper {
    height: auto;
    layout: vertical;
    border-top: hkey #2a2520;
}
#input-status-line {
    height:     1;
    layout:     horizontal;
    padding:    0 2;
    background: #181512;
}
.input-status-text  { color: #7a7268; text-style: italic; width: auto; }
.input-status-ready { color: #4ecb71;  text-style: bold; width: auto; }
.input-status-busy  { color: #e8c41a; text-style: bold; width: auto; }
.input-status-stream { color: #00e5b8; text-style: bold; width: auto; }
.input-status-error { color: #ff4444; text-style: bold; width: auto; }

#input-container {
    height:     auto;
    layout:     horizontal;
    padding:    0 1;
    background: #181512;
}
#prompt-sym {
    color:      #ef7c53;
    text-style: bold;
    width:      3;
    height:     auto;
    padding:    1 0;
}
ProtoxInput {
    width:          1fr;
    height:         auto;
    min-height:     3;
    max-height:     10;
    background:     #080604;
    color:          #e8e3dd;
    border:         tall #2a2520;
    padding:        0 1;
    scrollbar-size: 1 1;
}
ProtoxInput:focus {
    border: tall #ef7c53;
}

/* ── MODALS BASE ─────────────────────────────────────────────────── */
ModalScreen {
    background: #0e0c0a 75%;
    align: center middle;
}

/* ── HELP MODAL ──────────────────────────────────────────────────── */
#help-overlay {
    width:      80;
    height:     40;
    background: #181512;
    border:     tall #ef7c53;
    layout:     vertical;
}
#help-modal-header {
    height:     1;
    background: #ef7c53;
    color:      #0e0c0a;
    text-style: bold;
    padding:    0 2;
}
#help-brand-bar {
    height:     1;
    background: #252017;
    color:      #00e5b8;
    padding:    0 2;
    text-style: italic;
}
#help-body {
    height:   1fr;
    padding:  1 2;
    overflow-y: auto;
}
.help-section-title {
    color:      #ef7c53;
    text-style: bold;
    margin-top: 1;
}
.help-section-sub {
    color:      #7a7268;
    text-style: italic;
}
.help-divider { color: #2a2520; }
.help-row     { layout: horizontal; height: 1; }
.help-key     { color: #ef7c53; text-style: bold; width: 22; }
.help-desc    { color: #c8c0b8; width: 1fr; }
.help-tip-icon { color: #00e5b8;  width: 4; }
.help-tip-text { color: #a8a098; width: 1fr; }
#help-modal-footer {
    height:     1;
    background: #0e0c0a;
    color:      #5a524a;
    text-align: center;
    text-style: italic;
}

/* ── ABOUT MODAL ─────────────────────────────────────────────────── */
#about-overlay {
    width:      70;
    height:     30;
    background: #181512;
    border:     tall #ef7c53;
    layout:     vertical;
}
#about-header {
    height:     1;
    background: #ef7c53;
    color:      #0e0c0a;
    text-style: bold;
    padding:    0 2;
}
#about-body {
    height:   1fr;
    padding:  1 4;
    layout:   vertical;
}
#about-logo {
    color:      #ef7c53;
    text-style: bold;
    text-align: center;
    width:      100%;
}
#about-info {
    color:      #c8c0b8;
    margin-top: 1;
    text-align: center;
    width:      100%;
}
#about-separator { color: #2a2520; }
#about-credits {
    color:      #7a7268;
    text-style: italic;
    text-align: center;
    width:      100%;
}
#about-footer {
    height:     1;
    background: #0e0c0a;
    color:      #5a524a;
    text-align: center;
    text-style: italic;
}

/* ── MEMORY MODAL (NUOVO) ────────────────────────────────────────── */
#memory-overlay {
    width:      95%;
    height:     85%;
    background: #181512;
    border:     tall #00e5b8;
    layout:     vertical;
}
#memory-modal-header {
    height:     1;
    background: #00e5b8;
    color:      #0e0c0a;
    text-style: bold;
    padding:    0 2;
}
#memory-stats-bar {
    height:     1;
    background: #252017;
    color:      #7a7268;
    padding:    0 2;
    text-style: italic;
}
#memory-body {
    height:   1fr;
    padding:  1 1;
    overflow-y: auto;
}
#memory-modal-footer {
    height:     1;
    background: #0e0c0a;
    color:      #5a524a;
    text-align: center;
    text-style: italic;
}
DataTable {
    background:     #181512;
    color:          #e8e3dd;
    border:         tall #2a2520;
}
DataTable > .datatable--header {
    background: #0e0c0a;
    color:      #ef7c53;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #252017;
    color:      #e8e3dd;
}
DataTable > .datatable--hover {
    background: #252017;
}
